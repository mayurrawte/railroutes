{
  "name": "railroute-ts",
  "version": "0.0.1",
  "scripts": {
    "test": "vitest run",
    "build": "tsc"
  },
  "keywords": [
    "rail-route",
    "railroute",
    "rail-distance",
    "train-route",
    "railway-routing",
    "rail-network",
    "openstreetmap",
    "geojson",
    "dijkstra",
    "logistics",
    "freight",
    "multimodal",
    "shortest-path",
    "typescript"
  ],
  "author": "Mayur Rawte",
  "license": "MIT",
  "description": "Shortest rail route between two points. TypeScript library powered by the OpenStreetMap rail network. Returns GeoJSON.",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./networks/corridor": {
      "types": "./dist/networks/corridor.d.ts",
      "import": "./dist/networks/corridor.js"
    },
    "./package.json": "./package.json",
    "./stations/corridor": {
      "types": "./dist/stations/corridor.d.ts",
      "import": "./dist/stations/corridor.js"
    },
    "./networks/europe": {
      "types": "./dist/networks/europe.d.ts",
      "import": "./dist/networks/europe.js"
    },
    "./stations/europe": {
      "types": "./dist/stations/europe.d.ts",
      "import": "./dist/stations/europe.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayurrawte/railroutes.git"
  },
  "sideEffects": [
    "**/stations/*.js"
  ],
  "engines": {
    "node": ">=20"
  }
}