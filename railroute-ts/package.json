{
  "name": "railroute-ts",
  "version": "0.2.0",
  "scripts": {
    "test": "vitest run",
    "build": "tsc"
  },
  "keywords": [
    "rail-route",
    "railroute",
    "rail-routes",
    "railway-route",
    "train-route",
    "rail-distance",
    "train-distance",
    "railway-routing",
    "rail-network",
    "railway-network",
    "rail-freight",
    "freight",
    "logistics",
    "multimodal",
    "supply-chain",
    "emissions",
    "co2",
    "uic",
    "station-codes",
    "train-station",
    "openstreetmap",
    "osm",
    "overpass",
    "geojson",
    "dijkstra",
    "k-shortest",
    "yen-algorithm",
    "shortest-path",
    "itinerary",
    "eta",
    "europe",
    "typescript",
    "searoute",
    "india",
    "indian-railways",
    "north-america",
    "usa",
    "canada",
    "mexico",
    "narn"
  ],
  "author": "Mayur Rawte",
  "license": "MIT",
  "description": "Shortest rail route between any two points or stations. TypeScript/JavaScript rail routing with bundled OpenStreetMap networks (Europe-wide + Rhine-Alpine corridor), UIC station codes, K-shortest alternatives, multi-leg itineraries, and ETA from speed. Returns GeoJSON. Zero dependencies. Sibling of searoute-ts.",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./networks/corridor": {
      "types": "./dist/networks/corridor.d.ts",
      "import": "./dist/networks/corridor.js"
    },
    "./package.json": "./package.json",
    "./stations/corridor": {
      "types": "./dist/stations/corridor.d.ts",
      "import": "./dist/stations/corridor.js"
    },
    "./networks/europe": {
      "types": "./dist/networks/europe.d.ts",
      "import": "./dist/networks/europe.js"
    },
    "./stations/europe": {
      "types": "./dist/stations/europe.d.ts",
      "import": "./dist/stations/europe.js"
    },
    "./networks/india": {
      "types": "./dist/networks/india.d.ts",
      "import": "./dist/networks/india.js"
    },
    "./stations/india": {
      "types": "./dist/stations/india.d.ts",
      "import": "./dist/stations/india.js"
    },
    "./networks/north-america": {
      "types": "./dist/networks/north-america.d.ts",
      "import": "./dist/networks/north-america.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayurrawte/railroutes.git"
  },
  "sideEffects": [
    "**/stations/*.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/mayurrawte/railroutes/tree/main/railroute-ts#readme",
  "bugs": {
    "url": "https://github.com/mayurrawte/railroutes/issues"
  }
}
