{
  "name": "@railroute-ts/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing railroute-ts rail-route tools (rail_route, rail_route_alternatives, rail_station_search) for Europe and India to AI agents.",
  "type": "module",
  "bin": {
    "railroute-ts-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "railroute",
    "rail-route",
    "railway",
    "train",
    "freight",
    "multimodal",
    "ai-agents",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@railroute-ts/china": "^2026.9.0",
    "@railroute-ts/europe": "^2026.9.0",
    "@railroute-ts/india": "^2026.9.0",
    "@railroute-ts/north-america": "^2026.9.0",
    "railroute-ts": "^0.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayurrawte/railroutes.git",
    "directory": "examples/mcp-server"
  },
  "homepage": "https://github.com/mayurrawte/railroutes/tree/main/examples/mcp-server#readme",
  "mcpName": "io.github.mayurrawte/railroute"
}
